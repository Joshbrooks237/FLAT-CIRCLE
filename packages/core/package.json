{
  "name": "@flat-circle/core",
  "version": "0.1.0",
  "description": "Core Flat Circle security middleware — thirteen layers, four AI tiers, one philosophy.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "import": "./dist/types.mjs",
      "require": "./dist/types.js"
    },
    "./provider-cascade": {
      "import": "./dist/provider-cascade.mjs",
      "require": "./dist/provider-cascade.js"
    },
    "./mod7": {
      "import": "./dist/mod7.mjs",
      "require": "./dist/mod7.js"
    },
    "./pipeline": {
      "import": "./dist/pipeline.mjs",
      "require": "./dist/pipeline.js"
    },
    "./layers/layer2-honeypot": {
      "import": "./dist/layers/layer2-honeypot.mjs",
      "require": "./dist/layers/layer2-honeypot.js"
    },
    "./layers/layer8-recursive": {
      "import": "./dist/layers/layer8-recursive.mjs",
      "require": "./dist/layers/layer8-recursive.js"
    },
    "./layers/layer11-merkle": {
      "import": "./dist/layers/layer11-merkle.mjs",
      "require": "./dist/layers/layer11-merkle.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "peerDependencies": {
    "openai": ">=4.0.0",
    "@anthropic-ai/sdk": ">=0.20.0"
  },
  "peerDependenciesMeta": {
    "openai": { "optional": true },
    "@anthropic-ai/sdk": { "optional": true }
  },
  "keywords": ["security", "middleware", "honeypot", "canary", "merkle", "ai"]
}
