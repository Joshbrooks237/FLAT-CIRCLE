FROM node:20-alpine AS builder
WORKDIR /app

RUN npm install -g pnpm@9

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/dashboard/package.json ./packages/dashboard/

RUN pnpm install --frozen-lockfile

COPY packages/dashboard ./packages/dashboard

# VITE_PROXY_URL tells the dashboard where to find the SSE stream.
# Default: same host on port 8080 (works when both run on the same machine).
ARG VITE_PROXY_URL=http://localhost:8080
ENV VITE_PROXY_URL=$VITE_PROXY_URL

RUN cd packages/dashboard && pnpm build

# ── Runtime: serve with nginx ─────────────────────────────────────────────────
FROM nginx:alpine
COPY --from=builder /app/packages/dashboard/dist /usr/share/nginx/html

# Simple nginx config — serve the SPA, proxy /flat-circle/stream to the proxy
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
